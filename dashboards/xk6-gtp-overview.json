{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource receiving k6 remote-write metrics.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "piechart", "name": "Pie chart", "version": ""}
  ],
  "annotations": {"list": []},
  "description": "Overview of xk6-gtp emitted metrics: request throughput, error rate, timeouts, latency percentiles, cause distribution, send errors, and Client reconnects. Queries target the metric names produced by xk6-output-prometheus-remote (k6_<metric>).",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / s",
      "description": "Rolling send rate summed across all message types.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "reqps",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null}
          ]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(k6_gtpv2_req_total[$__rate_interval]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Send error rate",
      "description": "gtpv2_send_error_total / gtpv2_req_total. Green under 1%, yellow to 5%, red above.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "percentunit",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 0.01},
            {"color": "red", "value": 0.05}
          ]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(k6_gtpv2_send_error_total[$__rate_interval])) / clamp_min(sum(rate(k6_gtpv2_req_total[$__rate_interval])), 1)",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Recv timeouts / s",
      "description": "Rate of gtpv2_timeout_total. Any non-zero value is coloured red.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "cps",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "red", "value": 0.0001}
          ]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(k6_gtpv2_timeout_total[$__rate_interval]))",
          "legendFormat": "timeouts/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Round-trip latency by msg_type (p50 / p95 / p99)",
      "description": "gtpv2_req_duration Trend converted by the Prometheus remote-write output into avg/p90/p95/p99/med gauges. Panel plots p50/p95/p99 per msg_type.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}
      },
      "targets": [
        {"expr": "k6_gtpv2_req_duration_med", "legendFormat": "p50 {{msg_type}}", "refId": "A"},
        {"expr": "k6_gtpv2_req_duration_p95", "legendFormat": "p95 {{msg_type}}", "refId": "B"},
        {"expr": "k6_gtpv2_req_duration_p99", "legendFormat": "p99 {{msg_type}}", "refId": "C"}
      ]
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Cause distribution (over selected range)",
      "description": "gtpv2_resp_cause increment counts bucketed by cause and msg_type over the dashboard time range.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["sum"], "fields": ""},
        "pieType": "donut",
        "tooltip": {"mode": "single"},
        "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]},
        "displayLabels": ["name", "percent"]
      },
      "targets": [
        {
          "expr": "sum by (cause, msg_type) (increase(k6_gtpv2_resp_cause[$__range]))",
          "legendFormat": "{{msg_type}} / cause={{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Send errors by msg_type",
      "description": "Rate of gtpv2_send_error_total per message type. Spikes here mean the request never left the socket (resolution failure, closed conn, etc).",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}
      },
      "targets": [
        {
          "expr": "sum by (msg_type) (rate(k6_gtpv2_send_error_total[$__rate_interval]))",
          "legendFormat": "{{msg_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Client reconnects by peer",
      "description": "gtpv2_conn_reconnect_total increments each time a Client re-opens its underlying socket. Flapping peers show up as steady-slope lines here.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "always",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum"]}
      },
      "targets": [
        {
          "expr": "sum by (peer) (increase(k6_gtpv2_conn_reconnect_total[$__range]))",
          "legendFormat": "{{peer}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["k6", "gtpv2", "xk6-gtp"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]},
  "timezone": "",
  "title": "xk6-gtp — GTPv2 Overview",
  "uid": "xk6-gtp-overview",
  "version": 1,
  "weekStart": ""
}
